# Copy to .env (which is gitignored) and fill in real values.

# Gusto OAuth — get client id/secret from https://dev.gusto.com (see RUNBOOK_GUSTO_DEV_APP.md)
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
# Filled in automatically by `calsavers-remit bootstrap-oauth`
GUSTO_REFRESH_TOKEN=

# Gusto company UUID. Find via the Gusto admin URL or via `calsavers-remit list-companies`
# after OAuth bootstrap.
GUSTO_COMPANY_UUID=

# API base. Use sandbox while developing; switch to production once tested.
GUSTO_API_BASE=https://api.gusto-demo.com

# OAuth callback host/port (must match what's registered in your Gusto dev app)
GUSTO_OAUTH_REDIRECT_HOST=localhost
GUSTO_OAUTH_REDIRECT_PORT=8765
