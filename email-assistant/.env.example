# --- Google OAuth (business account only in v1) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth2callback
# Stored after the consent flow; in prod read from Secret Manager instead.
GOOGLE_REFRESH_TOKEN=
BUSINESS_EMAIL=

# --- GCP ---
GCP_PROJECT_ID=
# Firestore database id (default: "(default)")
FIRESTORE_DATABASE=(default)

# --- Anthropic ---
ANTHROPIC_API_KEY=
TRIAGE_MODEL=claude-haiku-4-5-20251001
DRAFT_MODEL=claude-opus-4-7

# --- Notifications ---
# email-to-self target for the brief
BRIEF_TO=
# ntfy.sh topic for phone push (pick something unguessable)
NTFY_TOPIC=

# --- Tour-inquiry / Calendar ---
# Calendar to write tour-inquiry holds to. "primary" = your main business calendar.
BUSINESS_CALENDAR_ID=primary
# Your display name on outgoing drafts (e.g. "Nick"). Defaults to BUSINESS_EMAIL's local part.
OWNER_NAME=

# --- Receipts (optional; only set if you want receipts logged to a Sheet) ---
# Spreadsheet id (the long string in the Sheet URL between /d/ and /edit).
RECEIPT_SHEET_ID=
# Drive folder id where receipt PDFs get archived; leave empty for "My Drive" root.
RECEIPT_DRIVE_FOLDER_ID=

# --- Safety ---
# Set true to make every job a no-op (kill switch)
KILL=false
